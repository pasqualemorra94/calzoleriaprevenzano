# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/calzoleria_prevenzano_dev?schema=public"

# Node
NODE_ENV="development"

# secure-auth-sdk — REQUIRED
AUTH_SECRET=""          # min 32 random characters — generate with: openssl rand -hex 32
APP_URL=""              # e.g. https://yourdomain.com (used in verification/reset emails)

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email (Resend — recommended)
RESEND_API_KEY=
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_ADMIN="admin@yourdomain.com"

# Seed — admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""       # min 12 chars, must include uppercase + number + symbol
