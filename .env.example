# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/calzoleria_prevenzano_dev?schema=public"

# Node
NODE_ENV="development"

# Better Auth — REQUIRED
BETTER_AUTH_SECRET=""   # min 32 random characters — generate with: openssl rand -base64 32
BETTER_AUTH_URL=""      # e.g. http://localhost:3000 (base URL of your app)

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email (Resend — recommended)
RESEND_API_KEY=
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_ADMIN="admin@yourdomain.com"
# Destinatario notifiche nuovi ordini (titolare). Se vuoto, la notifica
# titolare viene saltata ma la conferma cliente parte comunque.
EMAIL_ORDERS="ordini@yourdomain.com"

# Seed — admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""       # min 12 chars, must include uppercase + number + symbol

# AI — OpenAI (GPT-4.1-mini for foot analysis + image generation)
OPENAI_API_KEY=sk-proj-xxx

# AI — fal.ai / Fashn.ai (virtual try-on)
FAL_KEY=xxx                         # fal.ai API key (from https://fal.ai/dashboard/keys) — used for other fal.ai models
FASHN_API_KEY=xxx                    # Fashn.ai API key — used for virtual try-on (hygelac model)
FASHN_API_BASE=https://api.fashn.ai/v1  # Fashn.ai direct API (hygelac model lives here, NOT on fal.ai)

# Analytics — Google Analytics 4 (Consent Mode v2 basic, gated da consenso cookie)
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXX"  # vuoto o assente = analytics disabilitato (componente <GoogleAnalytics /> diventa no-op)
