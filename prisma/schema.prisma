// ─── Calzoleria Prevenzano — Prisma Schema ─────────────────────────────────
// Site type: ecommerce
// Modules: auth, gdpr, payments, seo, security, email
//
// ─── Cascade delete rules ─────────────────────────────────────────────────
// Order       → OrderItem      : onDelete: Cascade
// Cart        → CartItem       : onDelete: Cascade
// AuthUser    → Cart, Order, Wishlist, Review, Address : onDelete: Cascade
// Product     → ProductVariant, ProductImage, Review   : onDelete: Cascade
// Category    → Product                              : onDelete: SetNull
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// secure-auth-sdk required models — DO NOT rename or modify field names.
// The SDK uses createPrismaAdapter(prisma) which maps to these exact names.
// ═══════════════════════════════════════════════════════════════════════════

model AuthUser {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String?
  role              String             @default("user") // "user" | "admin" — SDK uses string, not enum
  emailVerified     Boolean            @default(false)
  totpEnabled       Boolean            @default(false)
  lockedUntil       DateTime?
  lockedPermanently Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessions          AuthSession[]
  totpSecret        AuthTOTPSecret?
  backupCodes       AuthBackupCode[]
  emailTokens       AuthEmailToken[]
  lockouts          AuthLockout[]
  auditLogs         AuthAuditLog[]
  oauthAccounts     AuthOAuthAccount[]

  // Business relations
  addresses         Address[]
  orders            Order[]
  carts             Cart[]
  reviews           Review[]
  wishlistItems     Wishlist[]

  @@index([email])
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthTOTPSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String
  createdAt DateTime @default(now())
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthEmailToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String    // "verify_email" | "reset_password" | "magic_link"
  expiresAt DateTime
  usedAt    DateTime?
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AuthLockout {
  id             String    @id @default(cuid())
  userId         String
  failedAttempts Int       @default(0)
  lastAttemptAt  DateTime?
  user           AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAuditLog {
  id        String    @id @default(cuid())
  userId    String?
  event     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      AuthUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model AuthOAuthAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       String    // "google" | "github" | "apple" | "discord" | "microsoft"
  providerUserId String
  createdAt      DateTime  @default(now())
  user           AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// GDPR models — required when modules.gdpr === true
// ═══════════════════════════════════════════════════════════════════════════

model ConsentLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // "cookie" | "privacy" | "marketing"
  granted   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model DataRequest {
  id          String    @id @default(cuid())
  userId      String
  type        String    @default("export") // "export" | "delete" | "rectify"
  status      String    @default("pending") // "pending" | "processing" | "completed"
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// E-commerce business models — Calzoleria Prevenzano
// ═══════════════════════════════════════════════════════════════════════════

// ─── Category (hierarchical) ──────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

// ─── Product ──────────────────────────────────────────────────────────────

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String            @db.Text
  shortDescription String?
  price            Decimal           @db.Decimal(10, 2)
  compareAtPrice   Decimal?          @db.Decimal(10, 2) // prezzo barrato
  sku              String?           @unique
  isActive         Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  stock            Int               @default(0)
  weight           Decimal?          @db.Decimal(8, 2) // kg
  materials        String?           // materiali: "Pelle di vitello", "Cuoio", ecc.
  categoryId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedBy        String?

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  reviews          Review[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlistItems    Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([price])
}

// ─── ProductVariant ───────────────────────────────────────────────────────

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String   // "Nero / 40", "Marrone / 42", ecc.
  color       String?
  size        String?  // taglia: "38", "39", "40", ecc.
  price       Decimal? @db.Decimal(10, 2) // override prezzo variante
  stock       Int      @default(0)
  sku         String?  @unique
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, color, size])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

// ─── ProductImage ─────────────────────────────────────────────────────────

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  width     Int?
  height    Int?

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

// ─── Review ───────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int      // 1-5
  title      String?
  content    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
  @@index([createdAt])
}

// ─── Address ──────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  firstName  String
  lastName   String
  address1   String
  address2   String?
  city       String
  province   String   // sigla provincia: "MI", "RM", ecc.
  postalCode String   // CAP
  country    String   @default("IT")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       AuthUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      AuthUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

// ─── CartItem ─────────────────────────────────────────────────────────────

model CartItem {
  id         String          @id @default(cuid())
  cartId     String
  productId  String
  variantId  String?
  quantity   Int
  price      Decimal         @db.Decimal(10, 2) // prezzo snapshot al momento dell'aggiunta

  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ─── Order ────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique // numero ordine leggibile: "CP-2026-0001"
  userId         String
  status         String         @default("pending") // "pending" | "confirmed" | "processing" | "shipped" | "delivered" | "cancelled" | "refunded"
  subtotal       Decimal        @db.Decimal(10, 2)
  shippingCost   Decimal        @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal        @db.Decimal(10, 2) @default(0)
  total          Decimal        @db.Decimal(10, 2)
  discountAmount Decimal        @db.Decimal(10, 2) @default(0)
  shippingMethod String?
  trackingNumber String?
  notes          String?        @db.Text
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  user           AuthUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── OrderItem ────────────────────────────────────────────────────────────

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  addressId   String?
  name        String   // nome prodotto snapshot
  variantName String?  // nome variante snapshot
  price       Decimal  @db.Decimal(10, 2) // prezzo unitario snapshot
  quantity    Int

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  address     Address?        @relation(fields: [addressId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ─── Payment ──────────────────────────────────────────────────────────────

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  stripePaymentId String?  @unique
  stripeSessionId String?
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  status          String   @default("pending") // "pending" | "succeeded" | "failed" | "refunded"
  method          String?  // "card" | "bank_transfer" | "cash_on_delivery"
  metadata        Json?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stripePaymentId])
  @@index([status])
  @@index([createdAt])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─── DiscountCode ─────────────────────────────────────────────────────────

model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   @default("percentage") // "percentage" | "fixed"
  value     Decimal  @db.Decimal(10, 2)
  minOrder  Decimal? @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int      @default(0)
  startsAt  DateTime
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}
