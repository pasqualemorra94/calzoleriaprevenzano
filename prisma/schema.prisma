// ─── Calzoleria Prevenzano — Prisma Schema ─────────────────────────────────
// Site type: ecommerce
// Modules: auth (Better Auth), gdpr, payments, seo, security, email
//
// ─── Cascade delete rules ─────────────────────────────────────────────────
// Order       → OrderItem      : onDelete: Cascade
// Cart        → CartItem       : onDelete: Cascade
// user        → Cart, Order, Wishlist, Review, Address : onDelete: Cascade
// Product     → ProductVariant, ProductImage, Review   : onDelete: Cascade
// Category    → Product                              : onDelete: SetNull
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Better Auth — core models (user, session, account, verification)
// DO NOT rename fields. Better Auth adapter maps to these exact names.
// ═══════════════════════════════════════════════════════════════════════════

model user {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Admin plugin fields
  role       String    @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Better Auth relations
  sessions session[]
  accounts account[]

  // Business relations
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  reviews       Review[]
  wishlistItems Wishlist[]
  uploadedMedia Media[]

  @@index([email])
  @@map("users") // avoid PostgreSQL reserved word "user"
}

model session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// AuditLog — lightweight auth audit trail (via Better Auth database hooks)
// ═══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([event])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// GDPR models — required when modules.gdpr === true
// ═══════════════════════════════════════════════════════════════════════════

model ConsentLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String // "cookie" | "privacy" | "marketing"
  granted   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model DataRequest {
  id          String    @id @default(cuid())
  userId      String
  type        String    @default("export") // "export" | "delete" | "rectify"
  status      String    @default("pending") // "pending" | "processing" | "completed"
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

// ─── NewsletterSubscription (double opt-in) ──────────────────────
// Stato: pending → confirmed (via email link) | unsubscribed (via token link)
// Token unico usato sia per confirm che per unsubscribe (UUID v4 da crypto.randomUUID).
// ConsentLog viene loggato SOLO al passaggio pending→confirmed (audit-by-presence)
// e su unsubscribe (eccezione audit-by-presence: revoca esplicita di consenso pregresso).

model NewsletterSubscription {
  id          String    @id @default(cuid())
  email       String    @unique
  status      String    @default("pending") // "pending" | "confirmed" | "unsubscribed"
  token       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ─── ReturnRequest (form online richiesta reso) ──────────────────
// Form pubblico /resi-e-recesso/richiesta. Validation server-side: ordine esiste,
// email coincide, ≤14gg, idempotency (1 sola pending per orderNumber via business logic).
// Soft-block personalizzati: hasOnlyCustomItems=true se ordine ha solo subcategorie sandali.
// Admin gestisce status: pending → approved | rejected | completed.

model ReturnRequest {
  id                 String    @id @default(cuid())
  orderId            String
  orderNumber        String // denormalizzato per query/visibilità admin
  email              String // snapshot email al momento della richiesta
  fullName           String // snapshot nome cliente
  reason             String    @db.Text
  status             String    @default("pending") // "pending" | "approved" | "rejected" | "completed"
  adminNotes         String?   @db.Text
  hasOnlyCustomItems Boolean   @default(false) // soft-block flag (Art. 59.c)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

// ═══════════════════════════════════════════════════════════════════════════
// Stripe — idempotency (required when modules.payments === true)
// ═══════════════════════════════════════════════════════════════════════════

model StripeEvent {
  id          String   @id // Stripe event ID (evt_xxx)
  type        String
  processedAt DateTime
}

// ═══════════════════════════════════════════════════════════════════════════
// E-commerce business models — Calzoleria Prevenzano
// ═══════════════════════════════════════════════════════════════════════════

// ─── Category (hierarchical) ──────────────────────────────────────────────

model Category {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  parentId      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  variantConfig Json? // default variant config for products in this category
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

// ─── Product ──────────────────────────────────────────────────────────────

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String    @db.Text
  shortDescription String?
  price            Decimal   @db.Decimal(10, 2)
  compareAtPrice   Decimal?  @db.Decimal(10, 2) // prezzo barrato
  sku              String?   @unique
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  stock            Int       @default(0)
  weight           Decimal?  @db.Decimal(8, 2) // kg
  materials        String? // materiali: "Pelle di vitello", "Cuoio", ecc.
  variantConfig    Json? // JSON-based variant builder config (groups of options)
  aiMetadata       Json? // AI-generated metadata for foot-advisor matching (closureType, heelHeight, archSupport, etc.)
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  deletedBy        String?

  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([price])
}

// ─── ProductVariant ───────────────────────────────────────────────────────

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String // "Nero / 40", "Marrone / 42", ecc.
  color     String?
  size      String? // taglia: "38", "39", "40", ecc.
  price     Decimal? @db.Decimal(10, 2) // override prezzo variante
  stock     Int      @default(0)
  sku       String?  @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

// ─── ProductImage ─────────────────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  width     Int?
  height    Int?
  mediaId   String? // optional FK to Media library

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([sortOrder])
  @@index([mediaId])
}

// ─── Review ───────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1-5
  title      String?
  content    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
  @@index([createdAt])
}

// ─── Address ──────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String?
  firstName  String
  lastName   String
  address1   String
  address2   String?
  city       String
  province   String // sigla provincia: "MI", "RM", ecc.
  postalCode String // CAP
  country    String   @default("IT")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  guestEmail String? // email for guest orders (no user account)

  user       user?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  user?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

// ─── CartItem ─────────────────────────────────────────────────────────────

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  quantity        Int
  price           Decimal @db.Decimal(10, 2) // prezzo snapshot al momento dell'aggiunta
  selectedOptions Json? // [{ label: "Taglia", value: "38", color?: "#fff" }] — risolto dal variantConfig

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ─── Order ────────────────────────────────────────────────────────────────

model Order {
  id             String    @id @default(cuid())
  orderNumber    String    @unique // numero ordine leggibile: "CP-2026-0001"
  userId         String?
  status         String    @default("pending") // "pending" | "confirmed" | "processing" | "shipped" | "delivered" | "cancelled" | "refunded"
  subtotal       Decimal   @db.Decimal(10, 2)
  shippingCost   Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  shippingMethod String?
  trackingNumber String?
  notes          String?   @db.Text
  ipAddress      String?
  userAgent      String?
  guestEmail     String? // email for guest orders (no user account)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  user           user?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payments       Payment[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── OrderItem ────────────────────────────────────────────────────────────

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  addressId       String?
  name            String // nome prodotto snapshot
  variantName     String? // nome variante snapshot
  price           Decimal @db.Decimal(10, 2) // prezzo unitario snapshot
  quantity        Int
  selectedOptions Json? // copiato da CartItem — scelte cliente visibili nell'ordine

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  address Address?        @relation(fields: [addressId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ─── Payment ──────────────────────────────────────────────────────────────

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  stripePaymentId String?  @unique
  stripeSessionId String?
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  status          String   @default("pending") // "pending" | "succeeded" | "failed" | "refunded"
  method          String? // "card" | "bank_transfer" | "cash_on_delivery"
  metadata        Json?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stripePaymentId])
  @@index([status])
  @@index([createdAt])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─── DiscountCode ─────────────────────────────────────────────────────────

model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   @default("percentage") // "percentage" | "fixed"
  value     Decimal  @db.Decimal(10, 2)
  minOrder  Decimal? @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int      @default(0)
  startsAt  DateTime
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}

// ─── Variant Template ──────────────────────────────────────────────────
// Reusable variant form templates. Each template defines groups of options
// (e.g., "Colore" with swatches, "Tacco" with select) that produce a JSON config.
// Templates are applied to products by copying the JSON to product.variantConfig.

model VariantTemplate {
  id          String   @id @default(cuid())
  name        String // e.g. "Gioiello Samantha Colori"
  slug        String   @unique
  description String? // optional notes
  config      Json // the VariantConfig JSON (groups, options, images)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

// ─── Media ──────────────────────────────────────────────────────────────
// Centralized media library. Uploaded files are stored in public/uploads/YYYY/MM/
// and tracked in this table. ProductImage can optionally reference a Media record.

model Media {
  id           String  @id @default(cuid())
  filename     String // stored filename (unique)
  originalName String // original user-provided name
  mimeType     String // "image/jpeg", "image/png", "image/webp"
  size         Int // bytes
  width        Int? // image width (null for non-images)
  height       Int? // image height (null for non-images)
  alt          String? // alt text / description
  folder       String  @default("") // virtual folder (e.g. "products", "categories")
  url          String // public URL path: /uploads/YYYY/MM/filename
  uploadedById String?

  uploadedBy    user?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages ProductImage[]

  createdAt DateTime @default(now())

  @@unique([filename]) // prevent duplicate stored filenames
  @@index([uploadedById])
  @@index([mimeType])
  @@index([folder])
  @@index([createdAt])
}

// ─── AI Session ────────────────────────────────────────────────────────
// Persists AI foot analysis sessions so the admin doesn't need to
// regenerate the foot photo + analysis for each try-on.
// Only the try-on step (step 2) needs to be re-run.

model AiSession {
  id           String  @id @default(cuid())
  label        String? // optional label (e.g. "Cliente Maria")
  footImage    String // base64 data URI of the foot photo
  footProfile  Json // AIFootAnalysisResult from OpenAI
  suggestions  Json? // ProductMatch[] from matching
  analysisCost Float? // USD cost of the OpenAI analysis

  // Latest try-on result (for backward compat with session resume)
  tryonImageUrl    String? // last generated try-on image
  tryonProductId   String? // product used for last try-on
  tryonCreditsUsed Int? // credits consumed by last try-on
  tryonCostUsd     Float? // estimated USD for last try-on

  // Full try-on history (append-only, preserves all generated images)
  tryonHistory Json? // TryOnHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ─── ShippingConfig (singleton) ────────────────────────────────────────
// Configurazione runtime della spedizione. Singolo record con id="default".
// Modificabile via /admin/spedizione. Default seedati al primo accesso da
// getShippingConfig() (upsert) per preservare comportamento attuale del sito.
model ShippingConfig {
  id            String   @id @default("default")
  cost          Decimal  @default(7.90) @db.Decimal(10, 2)
  freeThreshold Decimal  @default(199.00) @db.Decimal(10, 2)
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@map("shipping_config")
}
