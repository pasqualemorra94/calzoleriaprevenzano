    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "prisma": "^6.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
